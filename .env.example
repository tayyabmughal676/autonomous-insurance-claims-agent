# OpenRouter API Key for live LLM / Multimodal Vision models
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default Models
DEFAULT_VISION_MODEL=google/gemini-2.5-flash
DEFAULT_REASONING_MODEL=google/gemini-2.5-flash

# Autonomous Straight-Through Processing (STP) Guardrails
STP_MAX_CLAIM_AMOUNT=2500.00
STP_MAX_FRAUD_SCORE=15.0
